+def pcolormesh_45deg(ax_or_plt, mat, lines=None, linewidth=0.8, *args, **kwargs):
+    """
+    Plot a contact map as a 45°-rotated triangular heatmap.
+
+    Parameters
+    ----------
+    ax_or_plt : matplotlib.axes.Axes or matplotlib.pyplot module or None
+        Target axes (preferred). If a pyplot module or None is given, uses plt.gca().
+    mat : np.ndarray (n x n)
+        Contact matrix.
+    lines : list[float] or None
+        Optional list of diagonal positions to overlay as dashed guides.
+    linewidth : float
+        Line width for guide lines.
+    *args, **kwargs :
+        Passed through to ax.pcolormesh (e.g., cmap='RdBu_r', vmin=..., vmax=...).
+
+    Returns
+    -------
+    im : QuadMesh
+        The pcolormesh artist.
+    ax : matplotlib.axes.Axes
+        The axes used for plotting.
+    """
+    # Resolve axes
+    ax = ax_or_plt
+    if ax is None or not hasattr(ax, "set_xlim"):
+        ax = plt.gca()
+
+    n = mat.shape[0]
+
+    # Rotation/scaling matrix and transformed coordinates
+    t = np.array([[1, 0.5], [-1, 0.5]])
+    A = np.dot(
+        np.array([(i[1], i[0]) for i in itertools.product(range(n, -1, -1), range(0, n + 1))]),
+        t
+    )
+
+    # Draw heatmap
+    im = ax.pcolormesh(
+        A[:, 1].reshape(n + 1, n + 1),
+        A[:, 0].reshape(n + 1, n + 1),
+        np.flipud(mat),
+        shading="auto",
+        *args, **kwargs
+    )
     im.set_rasterized(True)
+
+    # Optional dashed guide lines (use ax.plot, not plt.plot)
     if lines is not None:
         for line in lines:
